<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Executive Dashboard Pro</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { background-color: #020617; color: #f8fafc; font-family: -apple-system, system-ui, sans-serif; }
        .card { background: #0f172a; border-radius: 20px; padding: 1.25rem; margin-bottom: 1rem; border: 1px solid #1e293b; }
        .btn-action { background: #2563eb; transition: transform 0.1s; }
        .btn-action:active { transform: scale(0.95); }
        .stat-label { font-size: 0.65rem; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; }
    </style>
</head>
<body class="p-4 pb-24">

    <header class="flex justify-between items-center mb-6">
        <div>
            <h1 class="text-2xl font-bold tracking-tight">Daily Operations</h1>
            <p id="dateHeader" class="text-blue-400 text-xs font-semibold"></p>
        </div>
        <button onclick="window.location.reload()" class="text-slate-500 text-xl">↻</button>
    </header>

    <section class="card">
        <h2 class="text-blue-400 font-bold mb-4 flex items-center gap-2">📈 Trade Journal</h2>
        <div class="space-y-3">
            <input type="text" id="pair" placeholder="Pair (EURUSD)" class="w-full bg-slate-800 border-none rounded-lg p-3 text-sm">
            <div class="grid grid-cols-2 gap-2">
                <input type="number" id="rr" placeholder="RR" class="bg-slate-800 border-none rounded-lg p-3 text-sm">
                <select id="result" class="bg-slate-800 border-none rounded-lg p-3 text-sm">
                    <option value="WIN">WIN</option>
                    <option value="LOSS">LOSS</option>
                    <option value="BE">B.EVEN</option>
                </select>
            </div>
            <button onclick="logTrade()" class="w-full btn-action py-3 rounded-xl font-bold">Log Trade</button>
        </div>
        <div id="tradeHistory" class="mt-4 space-y-2 text-[10px]"></div>
    </section>

    <section class="card">
        <div class="flex justify-between items-center mb-4">
            <h2 class="text-emerald-400 font-bold">💪 Bulk & Fuel</h2>
            <button onclick="resetDaily()" class="text-[10px] text-red-400 underline">Reset Day</button>
        </div>
        
        <div class="grid grid-cols-3 gap-2 mb-4">
            <button onclick="addFuel(25, 45, 'USN')" class="bg-slate-800 p-2 rounded-lg text-[10px] border border-slate-700">USN SCOOP</button>
            <button onclick="addFuel(6, 1, 'EGG')" class="bg-slate-800 p-2 rounded-lg text-[10px] border border-slate-700">1 EGG</button>
            <button onclick="addWater(500)" class="bg-blue-900/30 p-2 rounded-lg text-[10px] border border-blue-500/20 text-blue-400">+500ML H2O</button>
        </div>

        <div class="grid grid-cols-3 gap-2 text-center">
            <div class="bg-slate-900 p-3 rounded-xl border border-slate-800">
                <p class="stat-label">Protein</p>
                <p class="text-xl font-bold text-emerald-400"><span id="pDisp">0</span>g</p>
            </div>
            <div class="bg-slate-900 p-3 rounded-xl border border-slate-800">
                <p class="stat-label">Carbs</p>
                <p class="text-xl font-bold text-orange-400"><span id="cDisp">0</span>g</p>
            </div>
            <div class="bg-slate-900 p-3 rounded-xl border border-slate-800">
                <p class="stat-label">Water</p>
                <p id="wStatus" class="text-xl font-bold text-blue-400"><span id="wDisp">0</span>L</p>
            </div>
        </div>
    </section>

    <section class="card bg-slate-900/50 border-blue-500/20">
        <h2 class="text-slate-200 font-bold mb-4 flex items-center gap-2 text-sm italic">📊 Monthly Insights (30 Day Window)</h2>
        <div id="monthlyStats" class="space-y-3 text-xs">
            <div class="flex justify-between p-2 bg-slate-800/50 rounded-lg">
                <span class="text-slate-400">Protein Consistency:</span>
                <span id="pConsistency" class="font-bold">--</span>
            </div>
            <div class="flex justify-between p-2 bg-slate-800/50 rounded-lg">
                <span class="text-slate-400">Avg Daily Carbs:</span>
                <span id="avgCarbs" class="font-bold text-orange-400">--</span>
            </div>
            <div class="flex justify-between p-2 bg-slate-800/50 rounded-lg">
                <span class="text-slate-400">Dehydration Alert:</span>
                <span id="dehydratedDays" class="font-bold text-red-400">--</span>
            </div>
        </div>
    </section>

    <script>
        // Data Structure
        let data = JSON.parse(localStorage.getItem('userStore')) || {
            trades: [],
            daily: { protein: 0, carbs: 0, water: 0, date: new Date().toLocaleDateString() },
            history: [] // Keeps record of every day
        };

        const PROTEIN_GOAL = 150;
        const WATER_GOAL = 3000;

        function init() {
            const today = new Date().toLocaleDateString();
            if (data.daily.date !== today) {
                // Save yesterday to history before resetting
                data.history.push({...data.daily});
                data.daily = { protein: 0, carbs: 0, water: 0, date: today };
            }
            document.getElementById('dateHeader').innerText = today;
            updateUI();
        }

        function addFuel(p, c) {
            data.daily.protein += p;
            data.daily.carbs += c;
            updateUI();
        }

        function addWater(ml) {
            data.daily.water += ml;
            updateUI();
        }

        function resetDaily() {
            if(confirm("Undo today's progress?")) {
                data.daily.protein = 0;
                data.daily.carbs = 0;
                data.daily.water = 0;
                updateUI();
            }
        }

        function logTrade() {
            const p = document.getElementById('pair').value;
            const r = document.getElementById('rr').value;
            const res = document.getElementById('result').value;
            if(!p || !r) return;
            data.trades.unshift({ pair: p, rr: r, result: res, date: new Date().toLocaleDateString() });
            document.getElementById('pair').value = '';
            document.getElementById('rr').value = '';
            updateUI();
        }

        function deleteTrade(index) {
            data.trades.splice(index, 1);
            updateUI();
        }

        function updateUI() {
            localStorage.setItem('userStore', JSON.stringify(data));
            
            // Daily Displays
            document.getElementById('pDisp').innerText = data.daily.protein;
            document.getElementById('cDisp').innerText = data.daily.carbs;
            document.getElementById('wDisp').innerText = (data.daily.water / 1000).toFixed(1);
            
            // Water Flag
            const wLabel = document.getElementById('wStatus');
            wLabel.className = data.daily.water < WATER_GOAL ? "text-xl font-bold text-red-400" : "text-xl font-bold text-blue-400";

            // Trade List
            const tCont = document.getElementById('tradeHistory');
            tCont.innerHTML = data.trades.slice(0, 5).map((t, i) => `
                <div class="flex justify-between bg-slate-900 p-2 rounded border-l-2 ${t.result === 'WIN' ? 'border-emerald-500' : 'border-red-500'}">
                    <span>${t.pair} (${t.rr}RR)</span>
                    <div class="flex gap-2">
                        <span class="${t.result === 'WIN' ? 'text-emerald-400' : 'text-red-400'}">${t.result}</span>
                        <button onclick="deleteTrade(${i})" class="text-slate-600">×</button>
                    </div>
                </div>
            `).join('');

            calculateSummary();
        }

        function calculateSummary() {
            const totalDays = data.history.length;
            if(totalDays === 0) return;

            const last30 = data.history.slice(-30);
            const proteinWins = last30.filter(d => d.protein >= PROTEIN_GOAL).length;
            const totalCarbs = last30.reduce((acc, curr) => acc + curr.carbs, 0);
            const dryDays = last30.filter(d => d.water < WATER_GOAL).length;

            document.getElementById('pConsistency').innerText = `${proteinWins}/${last30.length} Days`;
            document.getElementById('avgCarbs').innerText = `${Math.round(totalCarbs/last30.length)}g`;
            document.getElementById('dehydratedDays').innerText = `${dryDays} Days`;
        }

        init();
    </script>
</body>
</html>
